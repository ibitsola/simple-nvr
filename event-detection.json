{
  "enabled": false,
  "rootpath": "/mnt/cctv",
  "camera": "driveway",
  "classes": ["person", "cat", "dog"],
  "scanIntervalSeconds": 300,
  "sampleEverySeconds": 5,
  "maxFramesPerClip": 60,
  "tempFrameDir": "/tmp/simple-nvr-events",
  "pythonExecutable": "python3",
  "pythonDetectorPath": "scripts/detect-events.py",
  "yoloModel": "yolov8s.pt",
  "yoloImageSize": 960,
  "pythonTimeoutMs": 180000,
  "minConfidence": 0.25,
  "classConfidence": {
    "person": 0.25,
    "cat": 0.25,
    "dog": 0.25
  },
  "eventLogPath": "/mnt/cctv/events/events.jsonl",
  "thumbnailDir": "/mnt/cctv/events/thumbnails",
  "retentionDays": 30,
  "motionDetection": {
    "enabled": true,
    "pixelChangeThreshold": 5000,
    "minChangedAreaPercent": 1.0
  },
  "mockMode": false
}
