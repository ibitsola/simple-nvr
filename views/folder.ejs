<%- include('includes/head.ejs') %>
</head>

<body class="d-flex flex-column h-100">

    <%- include('includes/header.ejs') %>

    <div class="container py-4">

        <%- include('includes/breadcrumb.ejs') %>

        <div class="list-group">
            <% for (let i = 0; i < locations.length; i++) { const location = locations[i]; %>
            <a href="<%= location.route %>" class="list-group-item list-group-item-action">
                <span class="item-label">
                    <span class="item-icon"><%= location.type === 'folder' ? '📁' : location.type === 'video' ? '🎥' : '📄' %></span>
                    <span><%= location.name %></span>
                </span>
                <% if (location.type === 'video') { %>
                <span class="text-muted small">Video</span>
                <% } %>
            </a>
            <% } %>
        </div>
    </div>

    <%- include('includes/footer.ejs') %>
    <%- include('includes/end.ejs') %>