<%- include('includes/head.ejs') %>
</head>

<body class="d-flex flex-column h-100">

    <%- include('includes/header.ejs') %>

    <div class="container py-4">
        <h2 class="mb-4">Event Log</h2>

        <% if (events.length === 0) { %>
            <div class="alert alert-info">
                No events detected yet.
            </div>
        <% } else { %>
            <div class="list-group">
                <% for (let i = 0; i < events.length; i++) { const event = events[i]; %>
                <% const displayType = event.displayType || (event.type === 'cat' || event.type === 'dog' ? 'Animal' : event.type ? event.type.charAt(0).toUpperCase() + event.type.slice(1) : 'Unknown'); %>
                <div class="list-group-item">
                    <div style="display: flex; align-items: flex-start; gap: 1rem;">
                        <% if (event.thumbnailUrl) { %>
                            <img src="<%= event.thumbnailUrl %>" alt="Event thumbnail" style="width:100px;height:100px;object-fit:cover;border-radius:4px;">
                        <% } %>
                        <div style="flex: 1;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <h5 style="margin: 0;">
                                    <%= displayType %>
                                    <small class="text-muted" style="font-size: 0.7em; font-weight: normal;">YOLO: <%= event.type %></small>
                                </h5>
                                <span class="badge badge-primary"><%= Math.round(event.confidence * 100) %>%</span>
                            </div>
                            <div class="text-muted small">
                                <div><strong>Time:</strong> <%= event.timestampLocalDisplay || event.timestampUtc || event.timestamp %></div>
                                <div><strong>Camera:</strong> <%= event.camera %></div>
                                <% if (event.colour && event.colour !== 'unknown') { %>
                                    <div><strong>Colour:</strong> <%= event.colour %></div>
                                <% } %>
                            </div>
                            <div style="margin-top: 0.5rem;">
                                <% if (event.videoHref) { %>
                                    <a href="<%= event.videoHref %>" class="btn btn-sm btn-outline-primary">View Clip</a>
                                    <% if (event.usingDailyFallback) { %>
                                        <small class="text-muted ml-1">daily recording</small>
                                    <% } %>
                                <% } else { %>
                                    <span class="text-muted small">Clip unavailable</span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>
        <% } %>
    </div>

    <%- include('includes/footer.ejs') %>
    <%- include('includes/end.ejs') %>
